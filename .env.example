# Copier en .env (jamais commité — voir .gitignore) pour le dev local avec `vercel dev`.
# En production, configurer ces variables directement dans le dashboard Vercel
# (Project Settings > Environment Variables), jamais dans le code.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Origine autorisée à appeler l'API (CORS) — le domaine de la boutique.
ALLOWED_ORIGIN=https://ladress.re
